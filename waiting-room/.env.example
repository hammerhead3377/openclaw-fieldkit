# Lighthouse Waiting Room — Environment Template
# cp .env.example .env  then fill in values before deploying

# Pre-shared secret — all agents must present this in X-Spring-Token header
SPRING_TOKEN=your-secret-token-here

# JWT signing key — change from default, keep private
JWT_SECRET=change-me-to-something-strong

# JWT expiry in minutes (default 15)
JWT_TTL_MINUTES=15

# Claude (paid) — primary model
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local free) — fallback 1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Groq (free tier) — fallback 2
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192
